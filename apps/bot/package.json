{
  "name": "@eguru/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsup src/index.ts --dts --format esm --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@eguru/chatguru": "*",
    "@eguru/env": "*",
    "@eguru/logger": "*",
    "@eguru/ssm": "*",
    "@eguru/types": "*",
    "@eguru/user": "*",
    "@eguru/xmpp": "*"
  },
  "devDependencies": {
    "@eguru/tsconfig": "*"
  }
}
