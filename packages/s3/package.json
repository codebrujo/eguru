{
  "name": "@eguru/s3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm --clean",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@eguru/types": "*"
  },
  "devDependencies": {
    "@eguru/tsconfig": "*"
  }
}
