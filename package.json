{
  "name": "eguru",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "npm --workspace @eguru/bot run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm --workspace @eguru/bot run start",
    "types:check": "turbo run types:check"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
